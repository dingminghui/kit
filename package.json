{
  "name": "kit",
  "version": "1.0.0",
  "description": "Monorepo: React components, CLI, and Vite + React scaffold",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter './packages/*' dev",
    "build": "pnpm --filter './packages/*' build",
    "test": "pnpm --filter './packages/*' test",
    "lint": "pnpm run lint:fix",
    "lint:check": "pnpm run lint:eslint && pnpm run lint:style",
    "lint:fix": "pnpm run lint:eslint:fix && pnpm run lint:style:fix",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --max-warnings 0 --fix",
    "lint:style": "stylelint \"**/*.css\"",
    "lint:style:fix": "stylelint \"**/*.css\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm --filter './packages/*' clean && rm -rf node_modules",
    "storybook": "pnpm --filter @kit/components storybook",
    "build-storybook": "pnpm --filter @kit/components build-storybook",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "release:local": "pnpm --filter @kit/cli... build && KIT_BIN_DIR=\"$(pnpm bin --global)\" && test -n \"$KIT_BIN_DIR\" && ln -sfn \"$PWD/packages/cli/dist/index.js\" \"$KIT_BIN_DIR/kit\"",
    "kit": "node packages/cli/dist/index.js",
    "create": "node packages/cli/dist/index.js create"
  },
  "keywords": [
    "monorepo",
    "components",
    "scaffold",
    "react",
    "vite"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.18.0",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^39.0.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
